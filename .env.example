APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=canice_portal
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production must use `smtp` with real Hostinger SMTP credentials (PRD Section 3,
# sent via PHPMailer, no third-party transactional API). `log` is fine for local dev.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@canicetechnologies.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible), PRD Section 3. Required before any file-upload
# feature (Phase 2+) goes live.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

# Bounce detection mailbox (PRD Section 12). PollBouncesAction no-ops until these
# are set - create the mailbox on Hostinger first.
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=

# GitHub deploy webhook (see README "Auto-Deploy"). DEPLOY_WEBHOOK_SECRET must
# match the secret configured on the GitHub webhook exactly - generate your own
# with `openssl rand -hex 32`, never reuse one from another project. DEPLOY_GITHUB_TOKEN
# is a fine-grained PAT (Contents: Read-only, scoped to just this one repo) that lets
# this server download the built `production` branch - a completely different
# credential from whatever GitHub Actions uses to push that branch in the first place.
DEPLOY_WEBHOOK_SECRET=
DEPLOY_GITHUB_TOKEN=
DEPLOY_REPO=Chibuzor23456/-caniceportal
DEPLOY_BRANCH=production
# Only needed when the web server's document root is a fixed sibling
# directory the app can't be installed into directly (Hostinger's
# public_html, for example) - absolute path to that directory. Leave blank
# on any host where the document root can just point at this app's own
# public/ folder.
DEPLOY_PUBLIC_PATH=

VITE_APP_NAME="${APP_NAME}"
